{
  "name": "@xpro/hub",
  "private": true,
  "type": "module",
  "dependencies": {
    "@better-auth/core": "1.7.12",
    "@better-auth/kysely-adapter": "1.7.12",
    "@better-auth/oauth-provider": "1.7.12",
    "better-auth": "1.7.12",
    "kysely": "0.28.18",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "@xpro/accounts": "workspace:*",
    "@xpro/core": "workspace:*",
    "@xpro/stms": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-image-crop": "11.1.2",
    "qrcode.react": "4.2.0",
    "uuid": "14.0.3",
    "valibot": "1.5.0",
    "@base-ui/react": "1.9.0",
    "@tanstack/react-form": "1.33.5",
    "class-variance-authority": "0.7.1",
    "tailwind-merge": "3.7.0",
    "lucide-react": "1.61.0",
    "libphonenumber-js": "1.13.15",
    "@xpro/ui": "workspace:*"
  },
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "dev": "CLOUDFLARE_ENV=local vite dev --port 3001",
    "generate-routes": "tsr generate",
    "generate-auth-schema": "bun run scripts/generate-auth-schema.ts",
    "build": "vite build",
    "preview": "vite preview",
    "generate-types": "bun run generate-messages && wrangler types --env-interface HubEnv --include-runtime=false",
    "typecheck": "tsc --noEmit",
    "setup:initial-master": "bun run scripts/initial-master.ts",
    "generate-messages": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations --strategy cookie baseLocale"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.57.2",
    "@tanstack/router-cli": "1.167.38",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "wrangler": "4.136.2",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "@inlang/paraglide-js": "2.29.1",
    "@inlang/plugin-message-format": "4.5.5"
  }
}
