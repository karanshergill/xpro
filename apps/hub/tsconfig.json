{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "paths": {
      "#*": [
        "./src/*"
      ]
    },
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "node",
      "../../worker-runtime.d.ts",
      "./worker-configuration.d.ts"
    ]
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "worker-configuration.d.ts"
  ],
  "exclude": [
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
