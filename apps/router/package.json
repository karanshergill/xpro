{
  "name": "@xpro/router",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 3002 --inspector-port 9232 --local-protocol https --https-key-path ../../.certs/localhost-key.pem --https-cert-path ../../.certs/localhost.pem",
    "build": "wrangler deploy --dry-run --outdir dist",
    "generate-types": "wrangler types --env-interface RouterEnv --include-runtime=false",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "typescript": "6.0.3",
    "wrangler": "4.136.2"
  }
}
